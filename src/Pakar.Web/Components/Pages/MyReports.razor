@page "/reports"
@using Pakar.Application.DTOs
@using Pakar.Web.Components.Ui
@inject UserSession Session
@inject AuthenticatedApiClient Api

<PageTitle>My Reports · PAKAR</PageTitle>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
    <h1 class="mb-0">My Reports</h1>
    <a class="btn btn-ui" href="">Back to the map</a>
</div>

@if (loading)
{
    <p role="status">Loading reports…</p>
}
else if (!signedIn)
{
    <p class="notice"><a href="login">Log in</a> to view your reports.</p>
}
else if (error is not null)
{
    <div class="notice danger" role="alert">
        @error <button type="button" class="btn btn-ui btn-sm" @onclick="LoadAsync">Try again</button>
    </div>
}
else if (reports.Count == 0)
{
    <div class="card p-3">
        <h2 class="h5">No reports yet</h2>
        <p class="mb-0">Select a zone on the map to report an incorrect parking space status.</p>
    </div>
}
else
{
    <div class="mb-3">
        <button type="button" class="btn btn-ui btn-sm" @onclick="LoadAsync">Refresh reports</button>
    </div>
    <div class="row row-cols-1 row-cols-lg-2 g-3">
        @foreach (var report in reports)
        {
            <div class="col" @key="report.Id">
                <article class="card h-100 p-3">
                    <div class="d-flex flex-wrap align-items-start justify-content-between gap-2">
                        <h2 class="h5 mb-0">@report.SpotName</h2>
                        <StatusChip Status="@report.Status" />
                    </div>
                    <p class="text-secondary small mt-1 mb-2">
                        @report.ZoneName · <time datetime="@report.SubmittedAt.ToString("O")">@report.SubmittedAt.AddHours(7).ToString("dd/MM/yyyy, HH:mm") WIB</time>
                    </p>
                    <p class="report-text mb-2">@report.Description</p>
                    @if (!string.IsNullOrWhiteSpace(report.AdminNote))
                    {
                        <div class="notice mb-0">
                            <strong>Admin note</strong>
                            <p class="report-text mb-0">@report.AdminNote</p>
                        </div>
                    }
                </article>
            </div>
        }
    </div>
}

@code {
    private List<ReportDto> reports = [];
    private bool loading = true, signedIn;
    private string? error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try
        {
            signedIn = await Session.GetUserAsync() is not null;
            if (!signedIn)
            {
                reports = [];
                return;
            }

            var result = await Api.GetAsync<List<ReportDto>>("api/reports/mine");
            reports = result.Value ?? [];
            error = result.Error?.Message;
        }
        finally
        {
            loading = false;
        }
    }
}
