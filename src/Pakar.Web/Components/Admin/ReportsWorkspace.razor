@inherits AdminWorkspaceBase
<div class="page-heading"><div><p class="eyebrow">TINJAUAN PENGGUNA</p><h1>Laporan</h1><p>Tinjau laporan ketidaksesuaian status parkir.</p></div><button @onclick="Reload" disabled="@Busy">Muat ulang</button></div>
<WorkspaceFeedback Busy="Busy" Error="Error" Success="@Success" />
<div class="toolbar"><label>Status laporan<select @bind="filter" @bind:after="Filter"><option value="">Semua status</option><option value="PendingReview">Menunggu tinjauan</option><option value="Resolved">Diselesaikan</option><option value="Dismissed">Ditolak</option></select></label></div>
<div class="@(selected is null ? "" : "edit-grid")">
    <div><div class="table-card"><table><caption class="visually-hidden">Antrean laporan</caption><thead><tr><th>Lokasi</th><th>Pelapor</th><th>Status</th><th>Tindakan</th></tr></thead><tbody>
    @foreach(var report in data.Items){<tr><td><strong>@report.SpotName</strong><span class="cell-sub">@report.ZoneName</span></td><td>@report.SubmittedByName<span class="cell-sub">@Local(report.SubmittedAt)</span></td><td><StatusChip Status="@report.Status" /></td><td><button class="small" @onclick="() => Open(report)" disabled="@Busy">Lihat detail</button></td></tr>}
    </tbody></table>@if(!Busy && data.Items.Count==0){<div class="empty-state"><h2>Belum ada laporan</h2><p>Tidak ada laporan untuk filter ini.</p></div>}</div>
    <div class="pagination"><span>@data.TotalCount laporan · Halaman @data.Page dari @Math.Max(1,data.TotalPages)</span><div><button class="small" @onclick="Previous" disabled="@(Busy || page<=1)">Sebelumnya</button><button class="small" @onclick="Next" disabled="@(Busy || page>=data.TotalPages)">Berikutnya</button></div></div></div>
    @if(selected is not null)
    {
        <section class="card form-panel"><div class="zone-card-top"><p class="eyebrow">DETAIL LAPORAN</p><button class="text-button" @onclick="()=>selected=null" aria-label="Tutup detail laporan">×</button></div><h2>@selected.ZoneName · @selected.SpotName</h2><StatusChip Status="@selected.Status" /><p class="prose" style="margin-top:16px">@selected.Description</p><p class="muted">@selected.SubmittedByName · @Local(selected.SubmittedAt)</p>
        @if(SafeEvidence(selected.EvidenceImageUrl)){<a href="@selected.EvidenceImageUrl" target="_blank" rel="noopener noreferrer">Buka bukti lampiran ↗</a>}
        @if(selected.Status=="PendingReview"){
            <form @onsubmit="Review" @onsubmit:preventDefault><fieldset disabled="@Busy"><label style="margin-top:20px">Keputusan<select @bind="decision"><option value="Resolved">Selesaikan laporan</option><option value="Dismissed">Tolak laporan</option></select></label><FieldError Error="Error" Field="Decision" /><label>Catatan untuk pelapor<textarea @bind="note" maxlength="500" placeholder="Jelaskan hasil pemeriksaan (opsional)"></textarea></label><FieldError Error="Error" Field="Note" /><button class="primary" type="submit">Simpan keputusan</button></fieldset></form>
        }else{<div class="notice" style="margin-top:16px"><strong>Ditinjau oleh @selected.ReviewedByName</strong><p class="prose">@(selected.AdminNote ?? "Tidak ada catatan tambahan.")</p><span class="muted">@(selected.ReviewedAt is {} at ? Local(at) : "")</span></div>}
        </section>
    }
</div>
@code {
    private PagedResult<ReportDto> data = new([],1,20,0);
    private string filter="PendingReview",decision="Resolved",note="";
    private int page=1;
    private ReportDto? selected;
    protected override Task OnInitializedAsync()=>Reload();
    private async Task Load()=>data=await Api.Get<PagedResult<ReportDto>>($"api/reports?status={filter}&page={page}&pageSize=20",true);
    private Task Reload()=>Run(Load);
    private Task Filter(){page=1;selected=null;return Reload();}
    private Task Previous(){page--;return Reload();}
    private Task Next(){page++;return Reload();}
    private Task Open(ReportDto report)=>Run(async()=>{selected=await Api.Get<ReportDto>($"api/reports/{report.Id}",true);decision="Resolved";note="";});
    private Task Review()=>Run(async()=>{var id=selected!.Id;await Api.Write(HttpMethod.Post,$"api/reports/{id}/review",new ReviewReportRequest(decision,note));selected=await Api.Get<ReportDto>($"api/reports/{id}",true);await Load();},"Keputusan laporan berhasil disimpan.");
    private static bool SafeEvidence(string? value)=>Uri.TryCreate(value,UriKind.Absolute,out var url) && url.Scheme is "https" or "http";
    private static string Local(DateTime value)=>TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(value,DateTimeKind.Utc),TimeZoneInfo.FindSystemTimeZoneById("Asia/Jakarta")).ToString("dd MMM yyyy, HH:mm")+" WIB";
}
