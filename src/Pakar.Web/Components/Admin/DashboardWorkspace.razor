@inherits AdminWorkspaceBase
<div class="page-heading"><div><p class="eyebrow">PAKAR OPERASIONAL</p><h1>Ringkasan parkir</h1><p>Kelola fasilitas, sumber video, dan akses dalam satu tempat.</p></div><button @onclick="Reload" disabled="@Busy">Muat ulang</button></div>
<WorkspaceFeedback Busy="Busy" Error="Error" />
<div class="kpi-grid">
    <div class="card kpi-card"><p>Zona parkir</p><span class="kpi-value">@(loaded ? zones.Count.ToString() : "—")</span></div>
    <div class="card kpi-card"><p>Kapasitas total</p><span class="kpi-value">@(loaded ? zones.Sum(z=>z.TotalCapacity).ToString() : "—")</span><span class="cell-sub">slot parkir</span></div>
    <div class="card kpi-card"><p>Sumber video</p><span class="kpi-value">@(loaded ? cameras.Count.ToString() : "—")</span><span class="cell-sub">@(loaded ? cameras.Count(c=>c.IsActive)+" aktif" : "Memuat status")</span></div>
    <div class="card kpi-card"><p>Menunggu tinjauan</p><span class="kpi-value">@(loaded ? reports.ToString() : "—")</span><span class="cell-sub">laporan pengguna</span></div>
</div>
<div class="section-grid">
    <a class="card section-link" href="admin/zones"><h2>Zona parkir <span>↗</span></h2><p>Atur nama, deskripsi, dan kapasitas setiap zona.</p></a>
    <a class="card section-link" href="admin/cameras"><h2>Sumber video <span>↗</span></h2><p>Kelola rekaman video dan buka editor polygon slot.</p></a>
    <a class="card section-link" href="admin/users"><h2>Pengguna <span>↗</span></h2><p>Perbarui peran dan kelola akses akun.</p></a>
    <a class="card section-link" href="admin/reports"><h2>Laporan <span>↗</span></h2><p>Tinjau informasi parkir yang dilaporkan pengguna.</p></a>
</div>
<div class="notice" style="margin-top:24px"><strong>Alur pengaturan parkir</strong><p class="muted" style="margin:6px 0 0">Tambahkan zona → atur sumber video → gambar polygon slot → periksa hasil pada peta.</p></div>
@code {
    private List<ZoneAdminDto> zones=[];
    private List<CameraAdminDto> cameras=[];
    private int reports;
    private bool loaded;
    protected override Task OnInitializedAsync()=>Reload();
    private Task Reload()=>Run(async()=>{zones=await Api.Get<List<ZoneAdminDto>>("api/zones",true);cameras=await Api.Get<List<CameraAdminDto>>("api/cameras",true);reports=(await Api.Get<PagedResult<ReportDto>>("api/reports?status=PendingReview&pageSize=1",true)).TotalCount;loaded=true;});
}
