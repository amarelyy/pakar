# Copy to infra/vm/.env and fill the values. Never commit the filled file. Values have no quotes.
# Compose cuts or changes a value that contains $ or a space followed by #, so use neither.

# Address. On the server: SITE_ADDRESS=<label>.<region>.cloudapp.azure.com and SITE_URL=https://<same>
SITE_ADDRESS=localhost
SITE_URL=https://localhost
# Only when ports 80 or 443 are taken on a laptop (then SITE_URL needs the same port).
# HTTP_PORT=8081
# HTTPS_PORT=8443

# Folder with models/best.onnx and videos/, relative to this folder. On the server: /opt/pakar/assets
ASSETS_DIR=../../artifacts/vm-assets

IMAGE_PREFIX=pakar
IMAGE_TAG=local
# Frames per second analysed per video. With MODEL_THREADS=1, 0.5 keeps the worker below one CPU core with four videos.
WORKER_SAMPLE_FPS=0.5
MODEL_THREADS=1

# Pooled Neon URL (postgresql://...)
DATABASE_URL=
# Random values of 32 characters or more
Jwt__Key=
Ingest__ApiKey=
# First administrator; the password needs 12 characters or more
Admin__Email=
Admin__Password=
Admin__Name=Administrator
