<span class="status-chip @Status"><span aria-hidden="true">●</span> @Label</span>

@code {
    [Parameter, EditorRequired] public string Status { get; set; } = "unknown";

    private string Label => Status switch
    {
        "available" => "Tersedia",
        "almost_full" => "Hampir penuh",
        "full" => "Penuh",
        "unknown" => "Belum diketahui",
        "PendingReview" => "Menunggu tinjauan",
        "Resolved" => "Diselesaikan",
        "Dismissed" => "Ditolak",
        _ => "Belum ada data"
    };
}
