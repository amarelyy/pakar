@using Pakar.Shared.Dtos
@using System.Globalization
@inject ParkingApiClient Api
@implements IAsyncDisposable
<section aria-label="Hasil pengamatan worker">
<h3>Gambar yang sedang dianalisis</h3>
<p class="muted">Gambar, polygon, dan status di bawah berasal dari satu pengamatan worker. Rekaman sumber di bawahnya diputar terpisah.</p>
@if(frame is {} value)
{
    <p role="status">Waktu video: @value.Observation.MediaSeconds.ToString("F1") detik · Pengamatan: @value.Observation.ObservedAt.ToOffset(TimeSpan.FromHours(7)).ToString("HH:mm:ss") WIB · @Freshness(value)</p>
    <svg viewBox="0 0 1000 1000" style="width:100%;max-width:960px;aspect-ratio:16/9;background:#111" preserveAspectRatio="none" aria-label="Frame hasil AI dengan ROI">
        <image href="@("data:image/jpeg;base64,"+Convert.ToBase64String(value.Jpeg))" width="1000" height="1000" preserveAspectRatio="none" />
        @foreach(var polygon in value.Polygons)
        {
            var slot=value.Observation.Slots.FirstOrDefault(s=>s.SpotId==polygon.SpotId);
            var color=slot?.Status switch { "occupied"=>"#ff6161", "available"=>"#49e693", _=>"#ffd166" };
            var centerX=polygon.Polygon.Average(p=>p[0])*1000; var centerY=polygon.Polygon.Average(p=>p[1])*1000;
            <polygon points="@Points(polygon.Polygon)" fill="@color" fill-opacity="0.18" stroke="@color" stroke-width="3" />
            <g><text x="@N(centerX)" y="@N(centerY)" fill="white" stroke="black" stroke-width="0.6" font-size="30">@(value.Polygons.IndexOf(polygon)+1)</text></g>
        }
    </svg>
    <ul>@foreach(var slot in value.Observation.Slots){<li>@(value.Observation.Slots.IndexOf(slot)+1). @slot.SpotNumber: @(slot.Status switch {"occupied"=>"Terisi", "available"=>"Kosong teramati", _=>slot.Reason switch {"pending_debounce"=>"Menunggu konfirmasi", "frame_too_dark"=>"Gambar terlalu gelap", "frame_low_contrast"=>"Detail gambar tidak cukup", _=>"Belum diketahui"}})</li>}</ul>
}
else{<p role="status">@message</p>}
</section>
@code {
    [Parameter] public Guid CameraId { get; set; }
    private ProcessedFrameDto? frame;
    private string message="Menunggu frame worker…";
    private readonly CancellationTokenSource stop=new();
    private Task? polling;
    protected override Task OnInitializedAsync() { polling=Poll(); return Task.CompletedTask; }
    private async Task Poll()
    {
        try { while(!stop.IsCancellationRequested) {
            try { var next=await Api.Get<ProcessedFrameDto>($"api/cameras/{CameraId}/processed-frame",true,ct:stop.Token); await InvokeAsync(()=>{frame=next;StateHasChanged();}); }
            catch(Exception ex) when(ex is ApiException or HttpRequestException) { frame=null;message="Worker belum mengirim frame untuk konfigurasi sumber ini."; await InvokeAsync(StateHasChanged); }
            await Task.Delay(1000,stop.Token);
        }} catch(OperationCanceledException) { }
    }
    private static string N(double value)=>value.ToString("0.###",CultureInfo.InvariantCulture);
    private static string Points(double[][] polygon)=>string.Join(" ",polygon.Select(p=>N(p[0]*1000)+","+N(p[1]*1000)));
    private static string Freshness(ProcessedFrameDto value)=>DateTimeOffset.UtcNow-value.Observation.ObservedAt>TimeSpan.FromSeconds(15)?"Data lama · worker belum memperbarui":"Pengamatan aktif";
    public async ValueTask DisposeAsync(){stop.Cancel();if(polling is not null)try{await polling;}catch(OperationCanceledException){}stop.Dispose();}
}
