@page "/admin/zones"
@using Pakar.Application.DTOs
@using Pakar.Application.Validation
@using Pakar.Web.Components.Admin
@using Pakar.Web.Components.Ui
@inject AuthenticatedApiClient Api
@inject UserSession Session

<PageTitle>Zones</PageTitle>

<AdminOnly>
    <AdminPageHeader Title="Zones" />

    @if (info is not null)
    {
        <p class="notice success" role="status">@info</p>
    }

    <form class="admin-panel admin-form" aria-labelledby="zone-form-title" novalidate
          @onsubmit="SaveAsync" @onsubmit:preventDefault>
        <div class="admin-form-body">
            <h2 id="zone-form-title" class="admin-section-title">@(editingId is null ? "Add a zone" : "Edit zone")</h2>

            @if (error is not null)
            {
                <div class="notice danger" role="alert">
                    <div>@(error.Fields.Count == 0 ? error.Message : "Please fix the problems below.")</div>
                    @foreach (var message in OtherMessages)
                    {
                        <div>@message</div>
                    }
                </div>
            }

            @{
                var nameMessages = FieldMessages("name");
                var capacityMessages = FieldMessages("totalCapacity");
                var descriptionMessages = FieldMessages("description");
            }
            <fieldset class="admin-form-fields zone-fields" disabled="@saving">
                <div>
                    <label class="admin-label" for="zone-name">Zone name</label>
                    <input id="zone-name" class="form-control admin-input" @ref="zoneNameInput" @bind="form.Name"
                           maxlength="100" required placeholder="e.g. DTSL"
                           aria-invalid="@(nameMessages.Length > 0 ? "true" : null)"
                           aria-describedby="@(nameMessages.Length > 0 ? "zone-name-errors" : null)" />
                    @if (nameMessages.Length > 0)
                    {
                        <div id="zone-name-errors" class="admin-field-error">
                            @foreach (var message in nameMessages)
                            {
                                <div>@message</div>
                            }
                        </div>
                    }
                </div>
                <div>
                    <label class="admin-label" for="zone-capacity">Capacity</label>
                    <input id="zone-capacity" class="form-control admin-input tnum" type="number" min="1" max="500"
                           required @bind="form.TotalCapacity"
                           aria-invalid="@(capacityMessages.Length > 0 ? "true" : null)"
                           aria-describedby="@(capacityMessages.Length > 0 ? "zone-capacity-hint zone-capacity-errors" : "zone-capacity-hint")" />
                    <div id="zone-capacity-hint" class="form-text">1–500 parking spaces</div>
                    @if (capacityMessages.Length > 0)
                    {
                        <div id="zone-capacity-errors" class="admin-field-error">
                            @foreach (var message in capacityMessages)
                            {
                                <div>@message</div>
                            }
                        </div>
                    }
                </div>
                <div class="admin-form-wide">
                    <label class="admin-label" for="zone-description">Description <span>(optional)</span></label>
                    <textarea id="zone-description" class="form-control admin-input" @bind="form.Description"
                              maxlength="500" rows="2" placeholder="e.g. Entrance beside the main gate"
                              aria-invalid="@(descriptionMessages.Length > 0 ? "true" : null)"
                              aria-describedby="@(descriptionMessages.Length > 0 ? "zone-description-errors" : null)"></textarea>
                    @if (descriptionMessages.Length > 0)
                    {
                        <div id="zone-description-errors" class="admin-field-error">
                            @foreach (var message in descriptionMessages)
                            {
                                <div>@message</div>
                            }
                        </div>
                    }
                </div>
            </fieldset>
        </div>

        <div class="admin-inline admin-form-footer">
            <div class="admin-inline admin-form-actions">
                @if (editingId is not null)
                {
                    <button type="button" class="btn btn-ui" disabled="@saving" @onclick="CancelEdit">Cancel</button>
                }
                <button type="submit" class="btn btn-ui btn-ui-primary" disabled="@saving">
                    @(saving ? "Saving..." : editingId is null ? "Add zone" : "Save changes")
                </button>
            </div>
        </div>
    </form>

    <h2 class="admin-section-title">All zones</h2>
    @if (overrideListError is not null)
    {
        <div class="notice warning" role="alert">
            Status manual belum dapat dimuat.
            <button type="button" class="btn btn-ui btn-sm" @onclick="LoadOverridesAsync">Coba lagi</button>
        </div>
    }
    @if (overrideError is not null)
    {
        <div class="notice danger" role="alert">
            @overrideError.Message
            @foreach (var message in overrideError.Fields.Values.SelectMany(messages => messages))
            {
                <div>@message</div>
            }
        </div>
    }
    @if (overrideZone is { } zone)
    {
        <form class="admin-panel p-3 mb-3" @onsubmit="SaveOverrideAsync" @onsubmit:preventDefault>
            <fieldset disabled="@savingOverride">
                <legend class="h5">Atur status @zone.Name</legend>
                <label for="manual-status" class="admin-label">Status zona</label>
                <select id="manual-status" class="form-select admin-input mb-3" @ref="overrideStatusInput" @bind="overrideStatus">
                    <option value="available">Tersedia</option>
                    <option value="almost_full">Hampir penuh</option>
                    <option value="full">Penuh</option>
                </select>
                <label for="manual-note" class="admin-label">Catatan <span>(opsional)</span></label>
                <textarea id="manual-note" class="form-control admin-input mb-3" @bind="overrideNote"
                          maxlength="@ZoneOverrideRules.MaxNoteLength" rows="2"></textarea>
                <div class="admin-inline">
                    <button type="submit" class="btn btn-ui btn-ui-primary">Simpan status</button>
                    <button type="button" class="btn btn-ui" @onclick="CloseOverride">Batal</button>
                </div>
            </fieldset>
        </form>
    }
    @if (loading)
    {
        <p role="status">Loading zones...</p>
    }
    else if (loadError is not null)
    {
        <p role="alert">@loadError</p>
    }
    else if (rows.Count == 0)
    {
        <p>No zones yet.</p>
    }
    else
    {
        <AdminTableRegion Label="All zones">
            <table class="table admin-table admin-table-zones">
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col" class="admin-cell-detail">Description</th>
                        <th scope="col" class="admin-cell-number">Capacity</th>
                        <th scope="col" class="admin-cell-number">Spots</th>
                        <th scope="col" class="admin-cell-number">Cameras</th>
                        <th scope="col" class="admin-cell-number">External ID</th>
                        <th scope="col">Status manual</th>
                        <th scope="col" class="admin-action-cell">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in rows)
                    {
                        var manual = overrides.GetValueOrDefault(row.Id);
                        <tr @key="row.Id">
                            <th scope="row" class="admin-cell-name">@row.Name</th>
                            <td class="admin-cell-wrap">@row.Description</td>
                            <td class="admin-cell-number">@row.TotalCapacity</td>
                            <td class="admin-cell-number">@row.SpotCount</td>
                            <td class="admin-cell-number">@row.CameraCount</td>
                            <td class="admin-cell-number">@row.ExternalId</td>
                            <td class="admin-cell-wrap">
                                @if (manual is not null)
                                {
                                    <StatusChip Status="@manual.Status" />
                                    @if (!string.IsNullOrWhiteSpace(manual.Note))
                                    {
                                        <span class="cell-sub">@manual.Note</span>
                                    }
                                }
                                else
                                {
                                    <span class="muted">@(overrideListError is null ? "Otomatis" : "Belum diketahui")</span>
                                }
                            </td>
                            <td class="admin-action-cell">
                                <div class="admin-row-actions">
                                    @if (confirmDeleteId == row.Id)
                                    {
                                        <span class="admin-confirmation">Remove this zone?</span>
                                        <button type="button" class="btn btn-ui btn-ui-danger btn-sm" @onclick="() => DeleteAsync(row)">Yes, remove</button>
                                        <button type="button" class="btn btn-ui btn-sm" @onclick="() => confirmDeleteId = null">Cancel</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-ui btn-sm" disabled="@saving" @onclick="() => StartEdit(row)">Edit</button>
                                        <button type="button" class="btn btn-ui btn-sm"
                                                disabled="@(savingOverride || overrideListError is not null)"
                                                @onclick="() => EditOverride(row, manual)">Atur status</button>
                                        <button type="button" class="btn btn-ui btn-ui-danger btn-sm" disabled="@saving"
                                                @onclick="() => confirmDeleteId = row.Id">Remove</button>
                                        @if (manual is not null && overrideListError is null)
                                        {
                                            <button type="button" class="btn btn-ui btn-sm"
                                                    disabled="@savingOverride" @onclick="() => ClearOverrideAsync(row)">Kembalikan otomatis</button>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </AdminTableRegion>
    }
</AdminOnly>

@code {
    private static readonly string[] KnownFields = ["name", "description", "totalCapacity"];

    private List<ZoneRow> rows = new();
    private ZoneForm form = new();
    private Guid? editingId;
    private Guid? confirmDeleteId;
    private bool loading = true;
    private bool saving;
    private string? loadError;
    private string? info;
    private ApiError? error;
    private Dictionary<Guid, ZoneOverrideDto> overrides = new();
    private ApiError? overrideListError;
    private ApiError? overrideError;
    private ZoneRow? overrideZone;
    private string overrideStatus = "full";
    private string? overrideNote;
    private bool savingOverride;
    private bool focusOverride;
    private ElementReference overrideStatusInput;
    private ElementReference zoneNameInput;
    private bool focusZoneForm;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusZoneForm)
        {
            focusZoneForm = false;
            await zoneNameInput.FocusAsync();
        }
        if (focusOverride)
        {
            focusOverride = false;
            await overrideStatusInput.FocusAsync();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Load only for admins; AdminOnly shows the login / access message to everyone else.
        var user = await Session.GetUserAsync();
        if (user?.IsAdmin == true) await LoadAsync();
        else loading = false;
    }

    private async Task LoadAsync()
    {
        loading = true;
        loadError = null;
        var result = await Api.GetAsync<List<ZoneRow>>("api/zones");
        if (result.Ok)
        {
            rows = result.Value ?? new();
            await LoadOverridesAsync();
        }
        else loadError = result.Error!.Message;
        loading = false;
    }

    private async Task LoadOverridesAsync()
    {
        var result = await Api.GetAsync<List<ZoneOverrideDto>>("api/zones/status-overrides");
        overrideListError = result.Error;
        if (result.Ok)
            overrides = (result.Value ?? []).ToDictionary(value => value.ZoneId);
    }

    private void EditOverride(ZoneRow row, ZoneOverrideDto? manual)
    {
        overrideZone = row;
        focusOverride = true;
        overrideStatus = manual?.Status ?? "full";
        overrideNote = manual?.Note;
        overrideError = null;
        info = null;
    }

    private void CloseOverride()
    {
        overrideZone = null;
        focusOverride = false;
        overrideError = null;
    }

    private Task SaveOverrideAsync() => overrideZone is { } row
        ? ChangeOverrideAsync(row, HttpMethod.Put, new SetZoneOverrideRequest(overrideStatus, overrideNote))
        : Task.CompletedTask;

    private Task ClearOverrideAsync(ZoneRow row) => ChangeOverrideAsync(row, HttpMethod.Delete);

    private async Task ChangeOverrideAsync(ZoneRow row, HttpMethod method, SetZoneOverrideRequest? request = null)
    {
        if (savingOverride)
            return;

        savingOverride = true;
        info = null;
        overrideError = null;
        try
        {
            var result = await Api.SendAsync(method, $"api/zones/{row.Id}/status-override", request);
            if (!result.Ok)
            {
                overrideError = result.Error;
                return;
            }

            if (overrideZone?.Id == row.Id)
                CloseOverride();
            info = method == HttpMethod.Delete
                ? $"Status {row.Name} kembali otomatis."
                : $"Status {row.Name} berhasil diatur.";
            await LoadOverridesAsync();
        }
        finally
        {
            savingOverride = false;
        }
    }

    private async Task SaveAsync()
    {
        if (saving)
            return;

        saving = true;
        error = null;
        info = null;

        var wasEdit = editingId is not null;
        var body = new ZoneRequest(form.Name.Trim(), form.Description?.Trim() ?? "", form.TotalCapacity);

        var result = editingId is { } id
            ? await Api.SendAsync(HttpMethod.Put, $"api/zones/{id}", body)
            : await Api.SendAsync(HttpMethod.Post, "api/zones", body);
        saving = false;

        if (!result.Ok)
        {
            error = result.Error;
            return;
        }

        info = wasEdit ? "Zone updated." : "Zone added.";
        ResetForm();
        await LoadAsync();
    }

    private async Task DeleteAsync(ZoneRow row)
    {
        error = null;
        info = null;
        var result = await Api.SendAsync(HttpMethod.Delete, $"api/zones/{row.Id}");
        confirmDeleteId = null;

        if (!result.Ok)
        {
            error = result.Error;
            return;
        }

        info = $"Zone \"{row.Name}\" removed.";
        await LoadAsync();
    }

    private void StartEdit(ZoneRow row)
    {
        editingId = row.Id;
        error = null;
        info = null;
        form = new ZoneForm { Name = row.Name, Description = row.Description ?? "", TotalCapacity = row.TotalCapacity };
        focusZoneForm = true;
    }

    private void CancelEdit()
    {
        error = null;
        ResetForm();
    }

    private void ResetForm()
    {
        editingId = null;
        form = new ZoneForm();
    }

    private string[] FieldMessages(string field) =>
        error is not null && error.Fields.TryGetValue(field, out var messages)
            ? messages
            : [];

    private IEnumerable<string> OtherMessages =>
        error is null
            ? Enumerable.Empty<string>()
            : error.Fields.Where(f => !KnownFields.Contains(f.Key, StringComparer.OrdinalIgnoreCase))
                          .SelectMany(f => f.Value);

    private sealed class ZoneRow
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public int TotalCapacity { get; set; }
        public int SpotCount { get; set; }
        public int CameraCount { get; set; }
        public int ExternalId { get; set; }
    }

    private sealed class ZoneForm
    {
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public int TotalCapacity { get; set; } = 10;
    }
}
