@page "/park"
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer
@using Microsoft.AspNetCore.SignalR.Client
@using Pakar.Shared.Dtos
@implements IAsyncDisposable

<h1>Live Occupancy Test</h1>

@if (spots is null)
{
    <p>Connecting...</p>
}
else
{
    <ul>
        @foreach (var s in spots)
        {
            <li>Spot @s.SpotId — @s.DetectedStatus (@s.ConfidenceScore)</li>
        }
    </ul>
}

@code {
    private HubConnection? hub;
    private List<ParkingSpotDto>? spots;

    protected override async Task OnInitializedAsync()
    {
        hub = new HubConnectionBuilder()
            .WithUrl("http://localhost:5000/occupancyHub") // match Pakar.Api's actual port
            .WithAutomaticReconnect()
            .Build();

        hub.On<List<ParkingSpotDto>>("ReceiveOccupancyUpdate", updated =>
        {
            spots = updated;
            InvokeAsync(StateHasChanged);
        });

        await hub.StartAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (hub is not null) await hub.DisposeAsync();
    }
}
