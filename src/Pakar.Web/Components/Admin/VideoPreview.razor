@inject IJSRuntime JS
@inject UserSession Session
@implements IAsyncDisposable
<section class="card video-preview" aria-label="Pratinjau video admin">
    <div class="zone-card-top"><div><p class="eyebrow">VIDEO DUMMY · ADMIN</p><h2>@Camera.Name</h2></div><button class="text-button" @onclick="Close" aria-label="Tutup pratinjau video">×</button></div>
    <p class="muted">@Camera.ZoneName · Rekaman ini mewakili area parkir untuk demonstrasi.</p>
    <ProcessedPreview @key="Camera.Id" CameraId="Camera.Id" />
    <h3>Rekaman sumber</h3>
    @if(loading){<p role="status">Memuat pratinjau video…</p>}
    @if(error is not null){<p class="notice danger" role="alert">@error</p><button class="small" @onclick="Load">Coba lagi</button>}
    <video @ref="video" controls loop playsinline preload="metadata" aria-label="Video dummy area parkir" @onerror="PlaybackError"></video>
    <p class="muted" style="font-size:11px;margin:10px 0 0">Pratinjau hanya tersedia untuk admin. Gunakan klip MP4/H.264 atau WebM hingga 50 MB.</p>
</section>
@code {
    [Parameter,EditorRequired] public CameraAdminDto Camera { get; set; } = null!;
    [Parameter] public EventCallback Close { get; set; }
    private ElementReference video;
    private readonly string previewId=Guid.NewGuid().ToString("N");
    private bool loading=true,disposed;
    private string? error;
    protected override async Task OnAfterRenderAsync(bool firstRender){if(firstRender){await Load();if(!disposed)StateHasChanged();}}
    private async Task Load()
    {
        loading=true;error=null;
        try
        {
            var user=await Session.GetUserAsync();
            if(user?.IsAdmin!=true){error="Sesi admin berakhir. Silakan masuk kembali.";return;}
            var result=await JS.InvokeAsync<string?>("pakarVideo.load",video,previewId,$"admin/video/{Camera.Id}",user.Token);
            if(!disposed)error=result;
        }
        catch(JSException){error="Video belum dapat diputar. Coba lagi.";}
        finally{loading=false;}
    }
    private void PlaybackError()=>error="Format video belum didukung browser ini. Gunakan MP4/H.264 atau WebM.";
    public async ValueTask DisposeAsync(){disposed=true;try{await JS.InvokeVoidAsync("pakarVideo.dispose",previewId);}catch(Exception ex) when(ex is JSDisconnectedException or JSException or TaskCanceledException){}}
}
