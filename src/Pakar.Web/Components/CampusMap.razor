@using Pakar.Web.Components.Ui

<div class="parking-page">
    <div class="parking-heading">
        <div>
            <p class="eyebrow">FAKULTAS TEKNIK · UNIVERSITAS GADJAH MADA</p>
            <h1>Temukan tempat parkirmu.</h1>
            <p class="muted">Cek ketersediaan zona sebelum menuju lokasi.</p>
        </div>
        <span class="connection-label @(IsLive ? "online" : "offline")" role="status">
            <span aria-hidden="true">●</span>
            @(IsLive ? "Pembaruan langsung aktif" : loading ? "Menghubungkan…" : "Pembaruan berkala")
        </span>
    </div>

    <div class="parking-workspace">
        <section class="parking-panel" aria-label="Daftar zona parkir">
            <div class="parking-search" role="group" aria-label="Filter zona parkir">
                <label for="zone-picker">Mau parkir di mana?</label>
                <select id="zone-picker" class="form-select" @bind="zoneFilterId" disabled="@(state.Zones.Count == 0)">
                    <option value="">Semua zona</option>
                    @foreach (var zone in state.Zones.OrderBy(zone => zone.Name))
                    {
                        <option @key="zone.Id" value="@zone.Id">@zone.Name</option>
                    }
                </select>
                <div class="filter-row">
                    <div>
                        <label for="zone-status">Status</label>
                        <select id="zone-status" class="form-select" @bind="status">
                            <option value="">Semua status</option>
                            <option value="available">Tersedia</option>
                            <option value="almost_full">Hampir penuh</option>
                            <option value="full">Penuh</option>
                        </select>
                    </div>
                    <div>
                        <label for="zone-minimum">Minimal slot kosong</label>
                        <input id="zone-minimum" class="form-control" type="number" min="0" @bind="minimum" />
                    </div>
                </div>
                @if (HasFilters)
                {
                    <button type="button" class="text-button small" @onclick="ResetFilters">Reset filter</button>
                }
            </div>
            @{
                var visible = VisibleZones.ToList();
            }
            <div class="zone-list-heading">
                <h2>@(HasFilters ? "Hasil filter" : "Zona parkir")</h2><span role="status">@visible.Count zona</span>
            </div>
            <div class="zone-list" aria-busy="@loading">
                @if (loading)
                {
                    <p class="empty-state" role="status">Memuat zona parkir…</p>
                }
                @if (error is not null)
                {
                    <div class="notice danger" role="alert">
                        @error <button type="button" class="text-button small" @onclick="ConnectAsync">Coba lagi</button>
                    </div>
                }
                @if (!loading && error is null && visible.Count == 0)
                {
                    <div class="empty-state">
                        <h2>@(state.Zones.Count == 0 ? "Belum ada zona" : "Tidak ada zona yang cocok dengan filter")</h2>
                        @if (HasFilters)
                        {
                            <button type="button" class="text-button" @onclick="ResetFilters">Reset filter</button>
                        }
                    </div>
                }
                @foreach (var zone in visible)
                {
                    <button type="button" @key="zone.Id" class="zone-card @(zone.Id == selectedId ? "selected" : null)"
                            @onclick="() => SelectAsync(zone.Id)" aria-pressed="@(zone.Id == selectedId)">
                        <span class="zone-card-top"><span class="zone-name">@zone.Name</span><StatusChip Status="@zone.Status" /></span>
                        <span class="zone-count"><strong class="tnum">@zone.AvailableSpots</strong><span>kosong <span class="muted">/ @zone.TotalCapacity slot</span></span><span class="zone-arrow" aria-hidden="true">↗</span></span>
                        <span class="fill-track" aria-hidden="true"><span class="@zone.Status" style="width:@Fill(zone)%"></span></span>
                        <span class="zone-meta">
                            @if (state.IsStale(zone, now))
                            {
                                <span class="stale">Data terakhir · sumber tidak aktif</span>
                            }
                            @if (zone.IsOverridden)
                            {
                                <span>Diatur admin</span>
                            }
                        </span>
                    </button>
                }
            </div>
            <div class="panel-foot">Ketersediaan dapat berubah saat Anda tiba.</div>
        </section>

        <section class="map-panel" aria-label="Peta parkir Fakultas Teknik UGM">
            <div class="map-surface">
                <div id="campus-map" class="campus-map"></div>
                <div class="map-top-note">
                    <span class="map-location">FT UGM · Yogyakarta</span>
                    <button type="button" class="btn btn-light small" @onclick="FitMapAsync" disabled="@(!mapReady)">Lihat semua zona</button>
                </div>
                <div class="map-legend">
                    <span><i class="available"></i> Tersedia</span><span><i class="almost_full"></i> Hampir penuh</span>
                    <span><i class="full"></i> Penuh</span><span><i class="unknown"></i> Data lama</span>
                </div>
                @if (mapError is not null)
                {
                    <p class="map-connection notice warning" role="status">@mapError</p>
                }
                else if (!IsLive && !loading)
                {
                    <div class="map-connection notice warning" role="status">
                        Pembaruan berkala aktif.
                        <button type="button" class="text-button small" @onclick="ConnectAsync" disabled="@connecting">Sambungkan kembali</button>
                    </div>
                }
            </div>
            @if (Selected is { } selected)
            {
                <section class="zone-detail card" aria-label="Detail zona">
                    <div class="zone-card-top">
                        <p class="eyebrow">ZONA PILIHAN</p>
                        <button type="button" class="text-button" @onclick="CloseDetailAsync" aria-label="Tutup detail zona">×</button>
                    </div>
                    <h2 @ref="detailHeading" tabindex="-1">@selected.Name</h2>
                    <div class="detail-count">
                        <strong>@selected.AvailableSpots</strong><span>slot kosong dari @selected.TotalCapacity</span><StatusChip Status="@selected.Status" />
                    </div>
                    @if (selected.IsOverridden)
                    {
                        <p class="muted">Status diatur admin.</p>
                    }
                    @if (state.IsStale(selected, now))
                    {
                        <p class="stale">Sumber tidak aktif atau data berusia lebih dari 2 menit.</p>
                    }
                    @if (selected.Spots.Count > 0)
                    {
                        <UserReportForm @key="selected.Id" Zone="selected" />
                    }
                    @if (selected.Status == "full")
                    {
                        @if (alternateLoading)
                        {
                            <p role="status">Mencari alternatif…</p>
                        }
                        @if (alternateError)
                        {
                            <p class="notice danger" role="alert">
                                Alternatif belum dapat dimuat.
                                <button type="button" class="text-button small" @onclick="LoadAlternateAsync">Coba lagi</button>
                            </p>
                        }
                        @if (alternate is { } suggestion)
                        {
                            <div class="alternative">
                                <p class="eyebrow">@(suggestion.Alternative is null ? "BELUM ADA ALTERNATIF" : "ALTERNATIF ZONA")</p>
                                @if (suggestion.Alternative is { } other)
                                {
                                    <button type="button" class="alternative-link" @onclick="() => SelectAsync(other.Id)">
                                        <span>
                                            <strong>@other.Name</strong>
                                            <span class="cell-sub">@other.AvailableSpots slot kosong@(other.DistanceMeters is { } distance ? $" · {distance:0} m dari zona ini" : "")</span>
                                        </span>
                                        <span aria-hidden="true">→</span>
                                    </button>
                                }
                                else
                                {
                                    <p>Belum ada zona lain dengan slot kosong.</p>
                                }
                            </div>
                        }
                    }
                    @if (selected.Spots.Count > 0)
                    {
                        <details class="slot-details">
                            <summary>Lihat @selected.Spots.Count slot terpetakan</summary>
                            <ul>
                                @foreach (var spot in selected.Spots)
                                {
                                    <li @key="spot.Id"><span>@spot.Name</span><span>@(spot.IsOccupied ? "Terisi" : "Kosong")</span></li>
                                }
                            </ul>
                        </details>
                    }
                </section>
            }
        </section>
    </div>
</div>
