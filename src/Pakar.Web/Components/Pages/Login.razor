@page "/login"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Pakar.Web.Services
@inject AuthApiClient Auth
@inject UserSession Session
@inject NavigationManager Navigation

<PageTitle>Log in</PageTitle>

<h1>Log in</h1>

@if (Registered)
{
    <p class="text-success" role="status">Account created. Please log in.</p>
}

<EditForm Model="model" OnValidSubmit="HandleLogin" class="auth-form">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <InputText id="email" type="email" class="form-control" @bind-Value="model.Email" autocomplete="email" />
        <ValidationMessage For="() => model.Email" />
    </div>

    <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <InputText id="password" type="password" class="form-control" @bind-Value="model.Password" autocomplete="current-password" />
        <ValidationMessage For="() => model.Password" />
    </div>

    @if (errorMessage is not null)
    {
        <p class="text-danger" role="alert">@errorMessage</p>
    }

    <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
        @(isSubmitting ? "Logging in..." : "Log in")
    </button>
</EditForm>

<p class="mt-3">No account yet? <a href="register">Register</a></p>

@code {
    [SupplyParameterFromQuery(Name = "registered")]
    public bool Registered { get; set; }

    private readonly LoginModel model = new();
    private bool isSubmitting;
    private string? errorMessage;

    // FR 8: log in with email and password; the token is kept for later authorized requests.
    private async Task HandleLogin()
    {
        isSubmitting = true;
        errorMessage = null;
        try
        {
            var result = await Auth.LoginAsync(model.Email.Trim(), model.Password);
            if (result is { Succeeded: true, Token: not null })
            {
                await Session.SignInAsync(result.Token);
                Navigation.NavigateTo("park");
                return;
            }

            errorMessage = result.Error ?? "Login failed. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private sealed class LoginModel
    {
        [Required, EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        public string Password { get; set; } = "";
    }
}
