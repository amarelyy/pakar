@implements IDisposable
@inject UserSession Session
@inject NavigationManager Navigation

@if (!loaded)
{
    return;
}

@if (user is null)
{
    <NavLink class="btn btn-ui btn-ui-quiet btn-sm" href="login">Log in</NavLink>
    <a class="btn btn-ui btn-sm" href="register">Register</a>
}
else
{
    <span class="account-name" title="@user.Email">
        <strong>@user.Name</strong>@(user.IsAdmin ? " (Admin)" : null)
    </span>
    <NavLink class="btn btn-ui btn-ui-quiet btn-sm" href="reports">Laporan Saya</NavLink>
    <button type="button" class="btn btn-ui btn-sm" @onclick="LogoutAsync">Log out</button>
}

@code {
    private SignedInUser? user;
    private bool loaded;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        user = await Session.GetUserAsync();
        loaded = true;
    }

    private async Task LogoutAsync()
    {
        await Session.SignOutAsync();
        Navigation.NavigateTo("");
    }

    private void OnSessionChanged() => _ = InvokeAsync(async () =>
    {
        user = await Session.GetUserAsync();
        StateHasChanged();
    });

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
