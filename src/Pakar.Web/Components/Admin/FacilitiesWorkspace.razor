@inherits AdminWorkspaceBase
<div class="page-heading"><div><p class="eyebrow">KONFIGURASI PARKIR</p><h1>@(Sources ? "Sumber video" : "Zona parkir")</h1><p>@(Sources ? "Kelola video rekaman yang digunakan untuk membaca kondisi parkir." : "Kelola area parkir dan kapasitasnya.")</p></div><button class="primary" @onclick="Add" disabled="@Busy">+ Tambah @(Sources ? "sumber" : "zona")</button></div>
<WorkspaceFeedback Busy="Busy" Error="Error" Success="@Success" />
<div class="toolbar"><label>Cari @(Sources ? "sumber video" : "zona")<input @bind="search" @bind:event="oninput" placeholder="Cari berdasarkan nama…" /></label><button @onclick="Reload" disabled="@Busy">Muat ulang</button></div>
@if(pendingId is not null)
{
    <section class="confirm-box" aria-label="Konfirmasi penghapusan"><strong>Hapus @pendingName?</strong><p>Item akan dihapus dari daftar aktif. Riwayat deteksi tetap disimpan.</p><div class="row-actions"><button @onclick="CancelDelete" disabled="@Busy">Batal</button><button class="danger-button" @onclick="Delete" disabled="@Busy">Ya, hapus</button></div></section>
}
@if(preview is not null){<VideoPreview @key="preview.Id" Camera="preview" Close="()=>preview=null" />}
<div class="@(showForm ? "edit-grid" : "")">
    <div class="table-card"><table><caption class="visually-hidden">@(Sources ? "Daftar sumber video" : "Daftar zona parkir")</caption><thead>
    @if(Sources){<tr><th>Sumber video</th><th>Zona</th><th>Status</th><th>Tindakan</th></tr>}
    else{<tr><th>Zona</th><th>Kapasitas</th><th>Terpetakan</th><th>Sumber</th><th>Tindakan</th></tr>}
    </thead><tbody>
    @if(Sources){
        @foreach(var camera in FilteredCameras){<tr><td><strong>@camera.Name</strong><span class="cell-sub">@(string.IsNullOrEmpty(camera.VideoFile) ? "File belum diatur" : camera.VideoFile)</span></td><td>@camera.ZoneName</td><td><StatusChip Status="@(camera.IsActive ? "active" : "inactive")" /><span class="cell-sub">@(camera.LastActiveTime is {} last ? "Terakhir " + Local(last) : "Belum mengirim data")</span></td><td><div class="row-actions"><button class="small" @onclick="()=>preview=camera" disabled="@(Busy || string.IsNullOrEmpty(camera.VideoFile))">Lihat video</button><button class="small" @onclick="()=>Edit(camera)" disabled="@Busy">Edit</button><a class="button small" href="@($"admin/polygons?cameraId={camera.Id}")">Polygon</a><button class="small danger-button" @onclick="()=>AskDelete(camera.Id,camera.Name)" disabled="@Busy">Hapus</button></div></td></tr>}
    }else{
        @foreach(var zone in FilteredZones){<tr><td><strong>@zone.Name</strong><span class="cell-sub">@zone.Description</span></td><td class="tnum">@zone.TotalCapacity slot</td><td class="tnum">@zone.SpotCount slot</td><td>@zone.CameraCount video</td><td><div class="row-actions"><button class="small" @onclick="()=>Edit(zone)" disabled="@Busy">Edit</button><button class="small danger-button" @onclick="()=>AskDelete(zone.Id,zone.Name)" disabled="@Busy">Hapus</button></div></td></tr>}
    }
    </tbody></table>
    @if(!Busy && (Sources ? !FilteredCameras.Any() : !FilteredZones.Any())){<div class="empty-state"><h2>@(search.Length>0 ? "Tidak ada hasil" : Sources ? "Belum ada sumber video" : "Belum ada zona")</h2><p>@(search.Length>0 ? "Coba kata kunci lain." : "Gunakan tombol tambah untuk mulai mengatur parkir.")</p></div>}</div>
    @if(showForm)
    {
        <form class="card form-panel" @onsubmit="Save" @onsubmit:preventDefault><fieldset disabled="@Busy"><p class="eyebrow">@(editingId is null ? "TAMBAH BARU" : "EDIT DATA")</p><h2>@(Sources ? "Sumber video" : "Zona parkir")</h2>
        <label>Nama<input @bind="name" required maxlength="100" /></label><FieldError Error="Error" Field="Name" />
        @if(Sources){
            <label>Zona parkir<select @bind="zoneId" required><option value="">Pilih zona</option>@foreach(var zone in zones){<option value="@zone.Id">@zone.Name</option>}</select></label><FieldError Error="Error" Field="ZoneId" />
            <label>Nama file video<input @bind="videoFile" maxlength="255" placeholder="contoh: parkir-teknik.mp4" /></label><FieldError Error="Error" Field="VideoFile" /><p class="muted">Gunakan nama file rekaman yang tersedia di server. File dapat diatur nanti.</p>
            @if(zones.Count==0){<p class="notice warning">Tambahkan zona parkir terlebih dahulu.</p>}
        }else{
            <label>Deskripsi<textarea @bind="description" maxlength="500"></textarea></label><FieldError Error="Error" Field="Description" /><label>Kapasitas total<input type="number" @bind="capacity" required min="1" max="500" /></label><FieldError Error="Error" Field="TotalCapacity" /><p class="muted">Kapasitas tidak boleh lebih kecil dari jumlah slot yang sudah terpetakan.</p>
        }
        <div class="form-actions"><button type="button" @onclick="()=>showForm=false">Batal</button><button class="primary" type="submit" disabled="@(Sources && zones.Count==0)">Simpan</button></div></fieldset></form>
    }
</div>
@if(!Sources){<p class="muted" style="margin-top:20px;font-size:12px">Pengaturan status zona secara manual akan tersedia setelah layanan override terintegrasi.</p>}
@code {
    [Parameter] public bool Sources { get; set; }
    private List<ZoneAdminDto> zones=[];
    private List<CameraAdminDto> cameras=[];
    private CameraAdminDto? preview;
    private string search="",name="",description="",videoFile="",pendingName="";
    private int capacity=1;
    private Guid? editingId,pendingId;
    private Guid zoneId;
    private bool showForm;
    private IEnumerable<ZoneAdminDto> FilteredZones=>zones.Where(z=>z.Name.Contains(search,StringComparison.OrdinalIgnoreCase)||z.Description.Contains(search,StringComparison.OrdinalIgnoreCase));
    private IEnumerable<CameraAdminDto> FilteredCameras=>cameras.Where(c=>c.Name.Contains(search,StringComparison.OrdinalIgnoreCase)||c.ZoneName.Contains(search,StringComparison.OrdinalIgnoreCase));
    protected override Task OnInitializedAsync()=>Reload();
    private async Task Load(){zones=await Api.Get<List<ZoneAdminDto>>("api/zones",true);if(Sources)cameras=await Api.Get<List<CameraAdminDto>>("api/cameras",true);}
    private Task Reload()=>Run(Load);
    private void Add(){editingId=null;name="";description="";videoFile="";capacity=1;zoneId=zones.FirstOrDefault()?.Id ?? Guid.Empty;showForm=true;Error=null;Success=null;}
    private void Edit(ZoneAdminDto zone){editingId=zone.Id;name=zone.Name;description=zone.Description;capacity=zone.TotalCapacity;showForm=true;Error=null;Success=null;}
    private void Edit(CameraAdminDto camera){editingId=camera.Id;name=camera.Name;zoneId=camera.ZoneId;videoFile=camera.VideoFile;showForm=true;Error=null;Success=null;}
    private Task Save()=>Run(async()=>{object body=Sources ? new CameraRequest(name.Trim(),zoneId,videoFile.Trim()) : new ZoneRequest(name.Trim(),description.Trim(),capacity);await Api.Write(editingId is null ? HttpMethod.Post : HttpMethod.Put,$"api/{(Sources ? "cameras" : "zones")}{(editingId is {} id ? "/"+id : "")}",body);showForm=false;preview=null;await Load();},"Data berhasil disimpan.");
    private void AskDelete(Guid id,string value){pendingId=id;pendingName=value;}
    private void CancelDelete()=>pendingId=null;
    private Task Delete()=>Run(async()=>{await Api.Write(HttpMethod.Delete,$"api/{(Sources ? "cameras" : "zones")}/{pendingId}");pendingId=null;showForm=false;preview=null;await Load();},"Data berhasil dihapus dari daftar aktif.");
    private static string Local(DateTime value)=>TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(value,DateTimeKind.Utc),TimeZoneInfo.FindSystemTimeZoneById("Asia/Jakarta")).ToString("dd MMM, HH:mm")+" WIB";
}
