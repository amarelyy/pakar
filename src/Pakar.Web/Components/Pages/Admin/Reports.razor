@page "/admin/reports"
@using Pakar.Application.Common
@using Pakar.Application.DTOs
@using Pakar.Web.Components.Admin
@using Pakar.Web.Components.Ui
@inject AuthenticatedApiClient Api
@inject UserSession Session

<PageTitle>Tinjau Laporan · PAKAR</PageTitle>

<AdminOnly>
    <AdminPageHeader Title="Tinjau laporan parkir">
        <Actions>
            <button type="button" class="btn btn-ui" disabled="@busy" @onclick="ReloadAsync">Muat ulang daftar</button>
        </Actions>
    </AdminPageHeader>

    @if (success)
    {
        <p class="notice success" role="status">Keputusan laporan tersimpan.</p>
    }
    @if (queueError is not null)
    {
        <p class="notice danger" role="alert">@queueError</p>
    }

    <div class="row g-3">
        <section class="@(selected is null ? "col-12" : "col-12 col-lg-7")" aria-label="Daftar laporan">
            <div class="admin-panel admin-toolbar">
                <label for="report-filter" class="admin-label">Status laporan</label>
                <div class="admin-inline gap-3">
                    <select id="report-filter" class="form-select admin-input admin-report-filter"
                            @bind="filter" @bind:after="FilterAsync" disabled="@busy">
                        <option value="">Semua status</option>
                        <option value="PendingReview">Menunggu tinjauan</option>
                        <option value="Resolved">Diselesaikan</option>
                        <option value="Dismissed">Ditolak</option>
                    </select>
                    @if (queue is not null)
                    {
                        <span class="admin-report-count" role="status">@queue.TotalCount laporan</span>
                    }
                </div>
            </div>
            @if (busy && queue is null)
            {
                <p role="status">Memuat laporan…</p>
            }
            @if (queue is { } data)
            {
                @if (data.Items.Count == 0)
                {
                    <p class="notice">Belum ada laporan untuk status ini.</p>
                }
                else
                {
                    <AdminTableRegion Label="Tabel laporan">
                        <table class="table admin-table">
                            <thead>
                                <tr>
                                    <th scope="col">Slot dan zona</th>
                                    <th scope="col" class="admin-cell-detail">Pelapor</th>
                                    <th scope="col" class="admin-cell-compact">Status</th>
                                    <th scope="col" class="admin-action-cell">Tindakan</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var report in data.Items)
                                {
                                    <tr @key="report.Id">
                                        <th scope="row" class="admin-cell-name">@report.SpotName<span class="cell-sub">@report.ZoneName</span></th>
                                        <td class="admin-cell-wrap">@report.SubmittedByName</td>
                                        <td class="admin-cell-compact"><StatusChip Status="@report.Status" /></td>
                                        <td class="admin-action-cell"><button type="button" class="btn btn-ui btn-sm" disabled="@busy"
                                                    @onclick="() => OpenReport(report)">Lihat detail</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </AdminTableRegion>
                }
                @if (data.TotalPages > 1)
                {
                    <div class="admin-inline">
                        <button type="button" class="btn btn-ui btn-sm" disabled="@(busy || data.Page <= 1)"
                                @onclick="() => LoadAsync(data.Page - 1)">Sebelumnya</button>
                        <span class="muted">Halaman @data.Page dari @data.TotalPages</span>
                        <button type="button" class="btn btn-ui btn-sm" disabled="@(busy || data.Page >= data.TotalPages)"
                                @onclick="() => LoadAsync(data.Page + 1)">Berikutnya</button>
                    </div>
                }
            }
        </section>

        @if (selected is { } current)
        {
            <div class="col-12 col-lg-5">
                <section class="admin-panel p-3" aria-label="Detail laporan">
                    <div class="admin-inline justify-content-between mb-2">
                        <h2 class="h5 mb-0" tabindex="-1" @ref="detailsHeading">@current.SpotName · @current.ZoneName</h2>
                        <button type="button" class="btn btn-ui btn-sm" disabled="@busy"
                                @onclick="CloseReport">Tutup</button>
                    </div>
                    <p><StatusChip Status="@current.Status" /></p>
                    <p class="muted small">
                        @current.SubmittedByName · <time datetime="@current.SubmittedAt.ToString("O")">@current.SubmittedAt.AddHours(7).ToString("dd/MM/yyyy, HH:mm") WIB</time>
                    </p>
                    <p class="report-text">@current.Description</p>
                    @if (Uri.TryCreate(current.EvidenceImageUrl, UriKind.Absolute, out var evidence) && evidence.Scheme is "https" or "http")
                    {
                        <p><a class="btn btn-ui btn-sm" href="@evidence.AbsoluteUri" target="_blank" rel="noopener noreferrer">Buka bukti lampiran</a></p>
                    }
                    @if (current.Status == "PendingReview")
                    {
                        <form @onsubmit="ReviewAsync" @onsubmit:preventDefault>
                            <fieldset disabled="@busy">
                                <label for="review-decision" class="admin-label">Keputusan</label>
                                <select id="review-decision" class="form-select admin-input mb-3" @bind="decision" required>
                                    <option value="">Pilih keputusan</option>
                                    <option value="Resolved">Selesaikan laporan</option>
                                    <option value="Dismissed">Tolak laporan</option>
                                </select>
                                <label for="review-note" class="admin-label">Catatan untuk pelapor <span>(opsional)</span></label>
                                <textarea id="review-note" class="form-control admin-input mb-3" @bind="note" maxlength="500" rows="3"></textarea>
                                @if (reviewError is not null)
                                {
                                    <p class="notice danger" role="alert">@reviewError</p>
                                }
                                <button type="submit" class="btn btn-ui btn-ui-primary">Simpan keputusan</button>
                            </fieldset>
                        </form>
                    }
                    else
                    {
                        <p class="muted mb-1">Ditinjau oleh @current.ReviewedByName</p>
                        @if (!string.IsNullOrWhiteSpace(current.AdminNote))
                        {
                            <p class="report-text mb-0">@current.AdminNote</p>
                        }
                    }
                </section>
            </div>
        }
    </div>
</AdminOnly>

@code {
    private string filter = "PendingReview";
    private string decision = "";
    private string note = "";
    private string? queueError, reviewError;
    private bool busy, success, focusDetails;
    private PagedResult<ReportDto>? queue;
    private ReportDto? selected;
    private ElementReference detailsHeading;

    protected override async Task OnInitializedAsync()
    {
        if ((await Session.GetUserAsync())?.IsAdmin == true)
            await LoadAsync(1);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusDetails)
        {
            focusDetails = false;
            await detailsHeading.FocusAsync();
        }
    }

    private Task ReloadAsync()
    {
        CloseReport();
        success = false;
        return LoadAsync(queue?.Page ?? 1);
    }

    private Task FilterAsync()
    {
        CloseReport();
        success = false;
        queue = null;
        return LoadAsync(1);
    }

    private async Task LoadAsync(int page)
    {
        busy = true;
        try
        {
            await RefreshQueueAsync(page);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RefreshQueueAsync(int page)
    {
        var query = $"api/reports?status={Uri.EscapeDataString(filter)}";
        var result = await Api.GetAsync<PagedResult<ReportDto>>($"{query}&page={page}");
        if (result.Value is { } data && data.Page > Math.Max(1, data.TotalPages))
            result = await Api.GetAsync<PagedResult<ReportDto>>($"{query}&page={Math.Max(1, data.TotalPages)}");

        queue = result.Value;
        queueError = result.Error?.Message;
    }

    private void OpenReport(ReportDto report)
    {
        selected = report;
        decision = note = "";
        reviewError = null;
        success = false;
        focusDetails = true;
    }

    private void CloseReport()
    {
        selected = null;
        reviewError = null;
        focusDetails = false;
    }

    private async Task ReviewAsync()
    {
        if (busy || selected is not { } report || report.Status != "PendingReview" || decision.Length == 0)
            return;

        busy = true;
        reviewError = null;
        success = false;
        try
        {
            var result = await Api.SendAsync<ReportDto>(HttpMethod.Post, $"api/reports/{report.Id}/review",
                new ReviewReportRequest(decision, note.Trim()));
            if (result.Value is { } reviewed)
            {
                selected = reviewed;
                success = true;
                await RefreshQueueAsync(queue?.Page ?? 1);
            }
            else
            {
                var failure = result.Error!;
                reviewError = failure.Fields.Count == 0
                    ? failure.Message
                    : string.Join(" ", failure.Fields.Values.SelectMany(messages => messages));
            }
        }
        finally
        {
            busy = false;
        }
    }
}
