@using System.Net.Http.Json
@using Pakar.Application.DTOs
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS
@inject ILogger<CampusMap> Logger
@implements IAsyncDisposable

<div id="campus-map" class="campus-map"></div>

@if (errorMessage is not null)
{
    <p class="map-error" role="alert">@errorMessage</p>
}

@if (zones is { Count: > 0 })
{
    <table class="table zone-summary">
        <thead>
            <tr>
                <th>Zone</th>
                <th>Available</th>
                <th>Capacity</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var zone in zones)
            {
                <tr class="@(zone.AvailableSpots == 0 ? "zone-full" : null)">
                    <td>@zone.Name</td>
                    <td>@zone.AvailableSpots</td>
                    <td>@zone.TotalCapacity</td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="map-legend">
    <span class="legend-dot available"></span> Available
    <span class="legend-dot occupied"></span> Occupied
</div>

@code {
    // FR 1: occupancy must be visible within 5 seconds of a change.
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(4);

    private List<ZoneDto>? zones;
    private string? errorMessage;
    private PeriodicTimer? timer;
    private bool mapInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await LoadZones();
        await JS.InvokeVoidAsync("campusMap.init", "campus-map", zones ?? []);
        mapInitialized = true;
        StateHasChanged();

        timer = new PeriodicTimer(RefreshInterval);
        _ = RefreshLoop();
    }

    private async Task LoadZones()
    {
        try
        {
            zones = await HttpClientFactory.CreateClient("api").GetFromJsonAsync<List<ZoneDto>>("api/parking/zones");
            errorMessage = null;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            Logger.LogWarning(ex, "Could not load parking zones.");
            errorMessage = "Could not load parking zones. Retrying...";
        }
    }

    private async Task RefreshLoop()
    {
        try
        {
            while (await timer!.WaitForNextTickAsync())
            {
                await LoadZones();
                if (zones is not null && mapInitialized)
                    await JS.InvokeVoidAsync("campusMap.renderZones", zones);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex) when (ex is ObjectDisposedException or JSDisconnectedException)
        {
            // The page was closed or the circuit dropped; stop refreshing.
        }
    }

    public async ValueTask DisposeAsync()
    {
        timer?.Dispose();
        try
        {
            if (mapInitialized)
                await JS.InvokeVoidAsync("campusMap.dispose");
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone; nothing to clean up in the browser.
        }
    }
}
